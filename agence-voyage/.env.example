# --- Postgres (utilisé par docker-compose) ---
POSTGRES_USER=agence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=agence_voyage

# --- Backend ---
# En local (hors Docker) l'hôte est localhost ; dans Docker c'est "db" (géré par docker-compose)
DATABASE_URL=postgresql://agence:change_me@localhost:5432/agence_voyage
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_long_random_string

# --- Frontend (seules les variables VITE_* sont exposées au navigateur) ---
VITE_API_URL=http://localhost:3000
